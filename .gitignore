# Build output (kotlinc jars, JNI native artefacts, generated JNI headers)
/build/
*.jar
*.class
# ...but the Gradle wrapper jar is a committed build-input, not build output.
!gradle/wrapper/gradle-wrapper.jar

# Native build artefacts staged next to the JNI shim for the desktop test leg
*.dll
*.dll.lib
*.exp
*.lib
*.so
*.dylib
*.pdb

# Generated JNI header (regenerated from the Kotlin `external` decls by `javac -h`)
/fuaran-core/src/main/jni/generated/

# Android packaging output (regenerated by the -Package leg)
/packaging/

# Gradle
/.gradle/
**/build/
# Android SDK location — machine-specific, never committed
local.properties

# IDE
/.idea/
*.iml
